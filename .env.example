# GC PATRIMONIAL — BACKEND
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versionar o .env de verdade (já coberto pelo .gitignore).

# Porta em que o servidor escuta. A maioria das plataformas de deploy
# injeta essa variável automaticamente — o default 3001 é só para
# desenvolvimento local.
PORT=3001

# Segredo usado para assinar/validar o JWT de sessão.
# Obrigatório — o servidor recusa iniciar sem isso (ver server.js).
# Gere um valor aleatório forte, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Conexão com o PostgreSQL. Os valores abaixo são os defaults usados hoje
# em desenvolvimento (server.js cai neles se as variáveis não estiverem
# definidas) — em qualquer ambiente compartilhado, defina-os explicitamente.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gc_patrimonial_app
DB_USER=postgres
DB_PASSWORD=
